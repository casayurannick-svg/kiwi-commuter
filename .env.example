# Kiwi Commuter Cost & Arbitrage Dashboard - Environment Variables

# Mapbox GL / Directions API (Required for interactive live map routing)
# Get a free public token from https://mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiZXhhbXBsZSIsImEiOiJjbGV4YW1wbGUwMDAwMG1vMHZ4ZTN5eGlsIn0.example

# Supabase (PostgreSQL cache for fuel prices, parking schedules & pre-calculated matrices)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Auckland Transport (AT) Developer Portal API Key
# Sign up at https://dev-portal.at.govt.nz to get your Primary Key
AT_API_SUBSCRIPTION_KEY=your_ocp_apim_subscription_key
OCP_APIM_SUBSCRIPTION_KEY=your_ocp_apim_subscription_key
