#!/bin/sh
# Block commits that contain secrets. Installed by `npm install` (prepare script sets core.hooksPath).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (brew install gitleaks). Commit blocked." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact -v || {
  echo "pre-commit: gitleaks found a possible secret. Remove it, or add a reviewed fingerprint to .gitleaksignore." >&2
  exit 1
}
